# Local development defaults (production values come from the add-on container).
# DATA_DIR controls where the SQLite DB and uploaded files live — both for the
# runtime backend AND for the Prisma CLI (see prisma.config.ts). /data in the add-on.
DATA_DIR=./data

# Optional: connect to a real Home Assistant during development.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=<long-lived access token>
# Force the built-in fixture registry even if HA_URL is set:
# HA_MOCK=true
# The HA connection is READ-ONLY by default; only set this to false once a
# future feature actually needs to write back to Home Assistant.
# HA_READ_ONLY=true
